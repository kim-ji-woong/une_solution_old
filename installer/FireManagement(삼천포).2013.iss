; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "소방설비 관리자"
#define MyAppVersion "1.0"
#define MyAppPublisher "UnE, Inc."
#define MyAppURL "http://www.unes.co.kr/"
#define MyAppExeName "FireManagement.exe"


[Setup]
#define VerFile FileOpen("..\bin\SOP\sop.ver")
#define AppVer FileRead(VerFile)
#expr FileClose(VerFile)
#undef VerFile
#define MyDateTimeString GetDateTimeString('yyyy.mm.dd_hhnnss', '-', ':');
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppID={{A39404B6-D763-4B82-A5F0-DEF464C5B276}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
;AppUpdatesURL={#MyAppURL}
DefaultDirName=\UnE\{#MyAppName}
DefaultGroupName=\UnE\{#MyAppName}
;InfoAfterFile=D:\Installer\vcredist_x64.exe
OutputDir=D:\Installer\output
OutputBaseFilename="FireManagementSetup_{#AppVer}_{#MyDateTimeString}"
SetupIconFile=D:\Installer\uninstallicon.ico
Compression=lzma/Max
SolidCompression=true
UninstallLogMode=append
UninstallFilesDir={app}

[Languages]
Name: "korean"; MessagesFile: "compiler:Languages\Korean.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; NOTE: Don't use "Flags: ignoreversion" on any shared system files
Source: ..\bin\SOP\FireManagement.exe; DestDir: {app}; 
Source: ..\bin\SOP\Ubists.NET.dll; DestDir: {app} 
Source: ..\bin\SOP\UbistsMobileLib.dll; DestDir: {app} 
Source: D:\Installer\SOP\Config\삼천포\config.ini; DestDir: {app};
Source: ..\bin\SOP\FMConfig.ini; DestDir: {app} 
Source: ..\bin\common12\Geometrydn.dll; DestDir: {app}
Source: ..\bin\common12\UEControl.dll; DestDir: {app}
;Source: ..\bin\SOP\DXFViewer.dll; DestDir: {app}
Source: ..\bin\SOP\DbUtil.dll; DestDir: {app}
Source: ..\src\SOP4\FireManagement\FireManagement\res\*; DestDir: {app}\res\; Flags: ignoreversion recursesubdirs createallsubdirs overwritereadonly
Source: ..\bin\SOP\FEData\삼천포 Data\data.fmf; DestDir: {app}\FEData\삼천포 Data\data.fmf; Flags: ignoreversion recursesubdirs createallsubdirs overwritereadonly
Source: ..\bin\SOP\FEData\DXF; DestDir: {app}\FEData\DXF; Flags: ignoreversion recursesubdirs createallsubdirs overwritereadonly
Source: D:\Installer\vcredist_x64.exe; DestDir: {app}; 
Source: D:\Installer\vcredist_x86.exe; DestDir: {app}; 
Source: D:\Installer\vcredist_x86_2013.exe; DestDir: {app}; 
; Dll
Source: ..\bin\common12\OpenCASCADE6.7.1\TKBRep.dll; DestDir: {app};
Source: ..\bin\common12\OpenCASCADE6.7.1\TKernel.dll; DestDir: {app};
Source: ..\bin\common12\OpenCASCADE6.7.1\TKernel.dll; DestDir: {app};
Source: ..\bin\common12\OpenCASCADE6.7.1\TKG2d.dll; DestDir: {app};
Source: ..\bin\common12\OpenCASCADE6.7.1\TKG3d.dll; DestDir: {app};
Source: ..\bin\common12\OpenCASCADE6.7.1\TKGeomAlgo.dll; DestDir: {app};
Source: ..\bin\common12\OpenCASCADE6.7.1\TKGeomBase.dll; DestDir: {app};
Source: ..\bin\common12\OpenCASCADE6.7.1\TKMath.dll; DestDir: {app};
[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"; WorkingDir: {app}; Languages: 

[Run]
;Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
Filename: {app}\vcredist_x86.exe; Description: "{#MyAppName} 실행에 필요한 필수 구성요소를 설치합니다.";
Filename: {app}\vcredist_x86_2013.exe; Description: "{#MyAppName} 실행에 필요한 필수 구성요소를 설치합니다.";
[Dirs]
Name: {app}\styles;

[InstallDelete]
Name: {app}\*.*; Type: filesandordirs

[UninstallDelete]
Name: {app}\*.*; Type: filesandordirs

