[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon
Name: {group}\{cm:UninstallProgram,{#MyAppName}}; Filename: {uninstallexe}; WorkingDir: {app}\{#MyAppName}; Languages:

[Run]
;Filename: "{app}\{#MyAppExeName}\vcredist_x86.exe"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
Filename: {app}\vcredist_x86.exe; Description: "{#MyAppName} 실행에 필요한 필수 구성요소를 설치합니다.";
Filename: msiexec.exe; Parameters: "/i""{app}\MSSpeech_TTS_ko-KR_Heami.msi"" /qn";
Filename: msiexec.exe; Parameters: "/i""{app}\SpeechPlatformRuntime.msi"" /qn";

