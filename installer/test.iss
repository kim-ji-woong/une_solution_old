[Run]
;Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
;Filename: {app}\vcredist_x64.exe; Description: Test 실행에 필요한 필수 구성요소를 설치합니다.; Flags: nowait postinstall skipifsilent
;Filename: {app}\vcredist_x86.exe; Description: Test 실행에 필요한 필수 구성요소를 설치합니다.; Flags: nowait postinstall skipifsilent

[InstallDelete]
Name: {app}\*.*; Type: filesandordirs

[UninstallDelete]
Name: {app}\*.*; Type: filesandordirs

[Code]
function GetCustomSetupExitCode: Integer;
  var
    ErrorCode: Integer;
    S: String;
  begin

  case ProcessorArchitecture of
    paX86: S := 'x86';
    paX64: S := 'x64';
    paIA64: S := 'Itanium';
  else
    S := 'Unrecognized';
  end;

  if ( S = 'x86' ) then begin
    ShellExec('open', ExpandConstant('{app}\vcredist_x86.exe'), '/SILENT' ,'', SW_SHOW, ewWaitUntilTerminated, ErrorCode);
  end else if ( S = 'x64') then begin
    ShellExec('open', ExpandConstant('{app}\vcredist_x64.exe'), '/SILENT' ,'', SW_SHOW, ewWaitUntilTerminated, ErrorCode);
  end;
end;
