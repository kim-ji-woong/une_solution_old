; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "SoilMan"
#define MyAppExeName "SoilMan64.exe"
#define MyAppVersion "1.01"
#define MyAppPublisher "UNE, Inc."
#define MyAppURL "http://www.unes.co.kr/"

[Setup]
#define MyDateTimeString GetDateTimeString('yyyy.mm.dd_hhnnss', '-', ':');
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{DCCF3892-B9AA-4288-B3BC-9D5E244408EC}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName=\UNE\{#MyAppName}
DefaultGroupName=\UNE\{#MyAppName}
OutputDir=D:\Installer\output
OutputBaseFilename="SoilManSetup_x64_{#MyAppVersion}_{#MyDateTimeString}"
SetupIconFile=D:\Installer\uninstallicon.ico
Compression=lzma
SolidCompression=yes
UninstallFilesDir={app}

[Languages]
Name: "korean"; MessagesFile: "compiler:Languages\Korean.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: dontinheritcheck

[Files]
; NOTE: Don't use "Flags: ignoreversion" on any shared system files
Source: ..\bin\SoilMan\Config.ini; DestDir: {app}; Components: FULL;
Source: ..\bin\SoilMan\법정동코드.txt; DestDir: {app}; Components: FULL;
Source: ..\bin\SoilMan\공시지가.txt; DestDir: {app}; Components: FULL;

; DLL
Source: ..\bin\common64\OpenCASCADE6.7.1\TKBRep.dll; DestDir: {app}; Components: FULL;
Source: ..\bin\common64\OpenCASCADE6.7.1\TKernel.dll; DestDir: {app}; Components: FULL;
Source: ..\bin\common64\OpenCASCADE6.7.1\TKG2d.dll; DestDir: {app}; Components: FULL;
Source: ..\bin\common64\OpenCASCADE6.7.1\TKG3d.dll; DestDir: {app}; Components: FULL;
Source: ..\bin\common64\OpenCASCADE6.7.1\TKGeomAlgo.dll; DestDir: {app}; Components: FULL;
Source: ..\bin\common64\OpenCASCADE6.7.1\TKGeomBase.dll; DestDir: {app}; Components: FULL;
Source: ..\bin\common64\OpenCASCADE6.7.1\TKMath.dll; DestDir: {app}; Components: FULL;
Source: ..\bin\common64\Geometrydn.dll; DestDir: {app}; Components: FULL;
Source: ..\bin\common64\DXFViewer.dll; DestDir: {app}; Components: FULL;
Source: ..\bin\common64\UEControl.dll; DestDir: {app}; Components: FULL;
Source: ..\bin\common64\libShapeFile.dll; DestDir: {app}; Components: FULL;
Source: ..\bin\common64\ClipperDotNet.dll; DestDir: {app}; Components: FULL;
Source: ..\bin\common64\poly2tri.dll; DestDir: {app}; Components: FULL;
Source: ..\bin\common64\NativeGDI.dll; DestDir: {app}; Components: FULL;

; EXE
Source: ..\bin\SoilMan\SoilMan64.exe; DestDir: {app}; Components: FULL;
;Source: ..\bin\SoilMan\RefreshIcon.exe; DestDir: {app}; Components: FULL;
Source: D:\Installer\vcredist_x64_2013.exe; DestDir: {app}; Components: FULL;
Source: D:\Installer\dotnetfx45_full_x86_x64.exe; DestDir: {app}; Components: FULL;

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon
Name: {group}\{cm:UninstallProgram,{#MyAppName}}; Filename: {uninstallexe}; WorkingDir: {app}\{#MyAppName}; Languages:

[Registry]
Root: HKCR; Subkey: ".prj"; ValueType: string; ValueName: ""; ValueData: "{#MyAppName}"; Flags: uninsdeletevalue
Root: HKCR; Subkey: "{#MyAppName}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\SoilMan.exe"; Flags: uninsdeletevalue
Root: HKCR; Subkey: "{#MyAppName}\Shell\Open\Command"; ValueType: string; ValueName: ""; ValueData: """{app}\SoilMan.exe"" ""%1"""; Flags: uninsdeletevalue

[Run]
;Filename: {app}\RefreshIcon.exe;
Filename: {app}\vcredist_x64_2013.exe; Description: "{#MyAppName} 실행에 필요한 필수 구성요소를 설치합니다.";
Filename: {app}\dotnetfx45_full_x86_x64.exe; Description: "{#MyAppName} .net Framework을 설치합니다.";

[InstallDelete]
Name: {app}\*.*; Type: filesandordirs

[UninstallDelete]
Name: {app}\*.*; Type: files

[Types] 
Name: FULL; Description: 전체 설치

[Components] 
Name: FULL; Description: "전체 설치"; Types: FULL; ExtraDiskSpaceRequired: 0; Flags: fixed; 
