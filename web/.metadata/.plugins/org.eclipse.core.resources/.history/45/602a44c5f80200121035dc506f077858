                int nTeamID = result.getInt("TeamID");
                String strPassword = result.getString("Password");
                String strUserID = result.getString("UserID");
	 		}

		}
		
	}catch(Exception e){
		out.println("JDBC 드라이브 연결 오류-"+e);
		e.printStackTrace();
	}
	finally{
 		try{
			if(result!=null)
				result.close();
			if(stmt!=null)
				stmt.close();
			if(conn!=null)
				conn.close();
 			out.println("연결끊음");
 		}
 		catch(Exception e){
