<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.unes.aqm.dao.AreaDAO">
	
	<resultMap id="result_depth1" type="kr.co.unes.aqm.dto.area.AreaDepth1">
		<result property="depth1" column="depth1"/>
	</resultMap>
	
	<resultMap id="result_depth2" type="kr.co.unes.aqm.dto.area.AreaDepth2">
		<result property="depth2" column="depth2"/>
	</resultMap>
	
	<resultMap id="result_depth3" type="kr.co.unes.aqm.dto.area.AreaDepth3">
		<result property="depth3" column="depth3"/>
	</resultMap>
	
	<resultMap id="result_depth4" type="kr.co.unes.aqm.dto.area.AreaDepth4">
		<result property="depth4" column="depth4"/>
	</resultMap>
	
	<resultMap id="result_area" type="kr.co.unes.aqm.dto.area.AreaName">
		<result property="depth1" column="depth1"/>
		<result property="depth2" column="depth2"/>
		<result property="depth3" column="depth3"/>
		<result property="depth4" column="depth4"/>
	</resultMap>
	
	<select id="getAreaDepth1" resultMap="result_depth1" useCache="true">
	  SELECT depth1 FROM Area group by depth1
	</select>
	
	<select id="getAreaDepth2" parameterType="String" resultMap="result_depth2">
	  SELECT 
	  	depth2 
	  FROM 
	  	Area
	  WHERE
	  	depth1=#{depth1} 
	  	group by depth2
	</select> 
	
	<select id="getAreaDepth3" parameterType="hashmap" resultMap="result_depth3">
      SELECT
      	depth3
      FROM
       Area
      WHERE
      	depth1=#{depth1} 
      AND 
      	depth2=#{depth2} 
      group by depth3
	</select> 
	
	<select id="getAreaDepth4" parameterType="hashmap" resultMap="result_depth4">
	  SELECT 
	  	depth4 
	  FROM Area 
	  WHERE 
	  	depth1=#{depth1,jdbcType=VARCHAR} 
	  AND 
	  	depth2=#{depth2,jdbcType=VARCHAR} 
  	  AND 
  	    depth3=#{depth3,jdbcType=VARCHAR}
	</select> 
	
	<select id="getAreaID" parameterType="hashmap" resultType="int">
	  SELECT 
	  	ID 
	  FROM
	  	Area
	  WHERE
	  	depth1=#{depth1} 
	  AND 
	  	depth2=#{depth2}
	  AND
	  	depth3=#{depth3}
	  AND
	  	depth4=#{depth4}
	</select>  
	
	<select id="getAreaName" parameterType="int" resultMap="result_area">
	  SELECT
	  	depth1,
	  	depth2,
	  	depth3,
	  	depth4
	  FROM
	  	Area
	  WHERE
	  	ID=#{areaId}
	</select> 
	
</mapper>