	<resultMap id="searchCityTown" class="g1Weather.service.data.CityTown">
		<result property="locationID" column="dev_info.id"/>
		<result property="locationName" column="dev_info.name"/>
	</resultMap>

	<select id="searchRainDAO.selectSearchRainTodayList" parameterClass="searchVO" resultClass="egovMap" resultMap="searchRainToday">

			SELECT
				dev_info.id, name, h00, h01, h02, h03, h04, h05, h06, h07, h08, h09, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23, daysum
			FROM dev_info, rain_accdata
			WHERE DISTCODE = #cityCode# and dev_info.id = rain_accdata.id and raindate = #dateCondition# order by name, raindate

	</select>

	<select id="searchRainDAO.selectSearchRainTodayListTotCnt" parameterClass="searchVO" resultClass="int">

			SELECT
				COUNT(*) totcnt
			FROM dev_info, rain_accdata
			WHERE DISTCODE = #cityCode# and dev_info.id = rain_accdata.id and raindate = #dateCondition# order by name, raindate

	</select>
	
	<select id="searchRainDAO.selectSearchRainMonthList" parameterClass="searchVO" resultClass="egovMap" resultMap="searchRainMonth">

			SELECT
				dev_info.id, name, raindate, daysum
			FROM dev_info, rain_accdata
			WHERE DISTCODE = #cityCode# and dev_info.id = rain_accdata.id and raindate like #dateCondition# order by name, raindate

	</select>
	
	<select id="searchRainDAO.selectSearchRainYearList" parameterClass="searchVO" resultClass="egovMap" resultMap="searchRainYear">

			SELECT
				dev_info.id, name, raindate, daysum
			FROM dev_info, rain_accdata
			WHERE DISTCODE = #cityCode# and dev_info.id = rain_accdata.id and raindate like #dateCondition# order by name, raindate

	</select>
	
	<select id="searchRainDAO.selectSearchRainPeriodList" parameterClass="searchVO" resultClass="egovMap" resultMap="searchRainPeriod">

			SELECT
				dev_info.id, name, raindate, h00, h01, h02, h03, h04, h05, h06, h07, h08, h09, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23, daysum
			FROM dev_info, rain_accdata
			WHERE dev_info.id = #townCode# and dev_info.id = rain_accdata.id and (raindate &gt;= #beginDateCondition# and raindate &lt;= #endDateCondition#) order by name, raindate

	</select>
	
	<select id="searchRainDAO.selectCityTownList" parameterClass="searchVO" resultClass="egovMap" resultMap="searchCityTown">

			SELECT
				id, name
			FROM dev_info
			WHERE DISTCODE = #cityCode# and kind in (1, 2, 3, 13)

	</select>
	
	<select id="searchRainDAO.selectCityName" parameterClass="searchVO" resultClass="String">

			SELECT
				distname
			FROM area_info
			WHERE DISTCODE = #cityCode#

	</select>

</sqlMap>