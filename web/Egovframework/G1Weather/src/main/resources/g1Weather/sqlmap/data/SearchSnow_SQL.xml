	<resultMap id="searchCityTown" class="g1Weather.service.data.CityTown">
		<result property="locationID" column="dev_info.id"/>
		<result property="locationName" column="dev_info.name"/>
	</resultMap>
	
	<select id="searchSnowDAO.selectSearchSnowTodayList" parameterClass="searchVO" resultClass="egovMap" resultMap="searchSnowToday">

			SELECT
				dev_info.id, name, h00, h01, h02, h03, h04, h05, h06, h07, h08, h09, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23, daysum
			FROM dev_info, snow_snow_new
			WHERE DISTCODE = #cityCode# and dev_info.id = snow_snow_new.id and snowdate = #dateCondition# order by name, snowdate

	</select>
	
	<select id="searchSnowDAO.selectSearchSnowMonthList" parameterClass="searchVO" resultClass="egovMap" resultMap="searchSnowMonth">

			SELECT
				dev_info.id, name, snowdate, daysum
			FROM dev_info, snow_snow_new
			WHERE DISTCODE = #cityCode# and dev_info.id = snow_snow_new.id and snowdate like #dateCondition# order by name, snowdate

	</select>
	
	<select id="searchSnowDAO.selectSearchSnowYearList" parameterClass="searchVO" resultClass="egovMap" resultMap="searchSnowYear">

			SELECT
				dev_info.id, name, snowdate, daysum
			FROM dev_info, snow_snow_new
			WHERE DISTCODE = #cityCode# and dev_info.id = snow_snow_new.id and snowdate like #dateCondition# order by name, snowdate

	</select>
	
	<select id="searchSnowDAO.selectSearchSnowPeriodList" parameterClass="searchVO" resultClass="egovMap" resultMap="searchSnowPeriod">

			SELECT
				dev_info.id, name, snowdate, h00, h01, h02, h03, h04, h05, h06, h07, h08, h09, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23, daysum
			FROM dev_info, snow_snow_new
			WHERE dev_info.id = #townCode# and dev_info.id = snow_snow_new.id and (snowdate &gt;= #beginDateCondition# and snowdate &lt;= #endDateCondition#) order by name, snowdate

	</select>
	
	<select id="searchSnowDAO.selectCityTownList" parameterClass="searchVO" resultClass="egovMap" resultMap="searchCityTown">

			SELECT
				id, name
			FROM dev_info
			WHERE DISTCODE = #cityCode# and kind in (8, 9, 10, 12)

	</select>
