	<resultMap id="searchCityTown" class="g1Weather.service.data.CityTown">
		<result property="locationID" column="dev_info.id"/>
		<result property="locationName" column="dev_info.name"/>
	</resultMap>
	
	<select id="searchWaterLevelDAO.selectSearchWaterLevelDayList" parameterClass="searchVO" resultClass="egovMap" resultMap="searchWaterLevelDay">

			SELECT
				dev_info.id, name, wldate, h00, h01, h02, h03, h04, h05, h06, h07, h08, h09, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23
			FROM dev_info, wl_acc
			WHERE DISTCODE = #cityCode# and dev_info.id = wl_acc.id and wldate = #dateCondition# order by name, wldate

	</select>
		
	<select id="searchWaterLevelDAO.selectSearchWaterLevelPeriodList" parameterClass="searchVO" resultClass="egovMap" resultMap="searchWaterLevelPeriod">

			SELECT
				dev_info.id, name, wldate, h00, h01, h02, h03, h04, h05, h06, h07, h08, h09, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23
			FROM dev_info, wl_acc
			WHERE dev_info.id = #townCode# and dev_info.id = wl_acc.id and (wldate &gt;= #beginDateCondition# and wldate &lt;= #endDateCondition#) order by name, wldate

	</select>
	
	<select id="searchWaterLevelDAO.selectCityTownList" parameterClass="searchVO" resultClass="egovMap" resultMap="searchCityTown">

			SELECT
				id, name
			FROM dev_info
			WHERE DISTCODE = #cityCode# and kind = 11

	</select>
	
