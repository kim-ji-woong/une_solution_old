<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/mainLayout"
    android:descendantFocusability="blocksDescendants"
    android:background="@color/colorBackground">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorTitleBack">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <ImageButton
                android:id="@+id/imageButton"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:paddingBottom="9dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/btn_home" />

            <ImageView
                android:id="@+id/imageView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="4.56"
                android:paddingBottom="10dp"
                android:paddingLeft="30dp"
                android:paddingRight="30dp"
                android:paddingTop="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_upper" />

            <ImageButton
                android:id="@+id/imageButton3"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:paddingBottom="9dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/notify_icon" />

            <ImageButton
                android:id="@+id/imageButton2"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:paddingBottom="9dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/search_icon" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/content_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <fragment
                android:id="@+id/main_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:name="kr.co.unes.aqm.lbs.map.fragment.SensorListFragment" />

            <fragment
                android:id="@+id/main_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:name="kr.co.unes.aqm.lbs.map.fragment.MainMapFragment" />

            <fragment
                android:id="@+id/map_local"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:name="kr.co.unes.aqm.lbs.map.fragment.BulletinFragment" />

            <fragment
                android:id="@+id/sensor_detail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:name="kr.co.unes.aqm.lbs.map.fragment.SensorDetailFragment" />


            <fragment
                android:id="@+id/search_main"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:name="kr.co.unes.aqm.lbs.map.fragment.SearchMainFragment" />


            <fragment
                android:id="@+id/search_address"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:name="kr.co.unes.aqm.lbs.map.fragment.SearchAddressFragment" />

            <fragment
                android:id="@+id/search_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:name="kr.co.unes.aqm.lbs.map.fragment.SearchNameFragment" />


            <fragment
                android:id="@+id/address_search_result"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:name="kr.co.unes.aqm.lbs.map.fragment.AddressSearchResultFragment" />

            <fragment
                android:id="@+id/sensor_detial_view"
                android:name="kr.co.unes.aqm.lbs.map.fragment.DetailAirQualityFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>
    </LinearLayout>

    <!-- Navigation Drawer ListView -->
    <ListView
        android:id="@+id/left_drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:choiceMode="singleChoice"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:background="@color/cast_libraries_material_featurehighlight_outer_highlight_default_color"
        android:drawSelectorOnTop="true"
        android:footerDividersEnabled="false"
        android:descendantFocusability="blocksDescendants"
        />
</android.support.v4.widget.DrawerLayout>
