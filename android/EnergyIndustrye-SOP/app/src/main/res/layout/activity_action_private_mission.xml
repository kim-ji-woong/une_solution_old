<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context="kr.co.une.energyindustrye_sop.ActionPrivateMission">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:id="@+id/imgTitle"
        android:text="개인 임무카드\nENERGY INDUSTRY FIELD TRAININIG"
        android:textColor="@color/colorTitleFore"
        android:background="@color/colorTitleBack"
        android:gravity="center"
        tools:layout_editor_absoluteY="0dp"
        tools:layout_editor_absoluteX="8dp" />

    <LinearLayout
        android:id="@+id/actionPrivateMissionBody"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        tools:layout_editor_absoluteY="8dp"
        tools:layout_editor_absoluteX="8dp">
        <LinearLayout
            android:id="@+id/actionPrivateMissionLeftPanel"
            android:layout_width="75dp"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/center_boss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="1dp"
                android:onClick="onTeamClick"/>
            <!--android:src="@drawable/center_boss_normal"-->
            <ImageView
                android:id="@+id/cs_team"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="1dp"
                android:onClick="onTeamClick"/>
            <!--android:src="@drawable/cs_team_normal"-->
            <ImageView
                android:id="@+id/ms_team"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="1dp"
                android:onClick="onTeamClick"/>
            <!--android:src="@drawable/ms_team_normal"-->
            <ImageView
                android:id="@+id/electric_team"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="1dp"
                android:onClick="onTeamClick"/>
            <!--android:src="@drawable/electric_team_normal"-->
            <ImageView
                android:id="@+id/operating_team"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="1dp"
                android:onClick="onTeamClick"/>
            <!--android:src="@drawable/operating_team_normal"-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colorTitleBack"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionPrivateMissionBodyPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-50dp"
            android:orientation="vertical">

            <ViewFlipper
                android:id="@+id/flipperSystem"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
            </ViewFlipper>
            <!--kr.co.une.energyindustrye_sop.photoview.PhotoView
                android:id="@+id/actionMissionImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="top"
                android:scaleType="fitXY" /-->
        </LinearLayout>
    </LinearLayout>

</android.support.constraint.ConstraintLayout>