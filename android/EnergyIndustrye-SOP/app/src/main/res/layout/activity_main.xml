<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/mainLayout"
    android:descendantFocusability="blocksDescendants"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/mainLayer"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/colorTitleBack">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/imgMainTitle"
                android:text="ENERGY INDUSTRY FIELD TRAININIG"
                android:textColor="@color/colorTitleFore"
                android:background="@color/colorTitleBack"
                android:gravity="center" />
            <!--ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/imgMainTitle"
                android:scaleType="fitCenter"
                android:src="@drawable/main_title" /-->
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layerLogo"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_weight="3"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgMainMenuLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|center_horizontal"
                android:layout_marginBottom="30dp"
                android:layout_marginLeft="50dp"
                android:layout_marginRight="50dp"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:scaleType="fitXY" />
            <!--android:src="@drawable/logo"-->

        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuParent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-60dp"
            android:layout_weight="2"
            android:orientation="vertical">

            <TableLayout
                android:id="@+id/layerMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:paddingBottom="30dp">

                    <ImageButton
                        android:id="@+id/btnActionRule"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_column="0"
                        android:layout_marginRight="10dp"
                        android:layout_row="0"
                        android:background="@android:color/transparent"
                        android:onClick="btnActionRuleClick"
                        android:scaleType="fitXY" />
                    <!--app:srcCompat="@drawable/action_rule_button"-->

                    <ImageButton
                        android:id="@+id/btnActionSOP"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_column="1"
                        android:layout_marginLeft="10dp"
                        android:layout_row="0"
                        android:background="@android:color/transparent"
                        android:onClick="btnActionSOPClick"
                        android:scaleType="fitXY" />
                    <!--app:srcCompat="@drawable/action_sop_button"-->
                </TableRow>

                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:paddingBottom="30dp">

                    <ImageButton
                        android:id="@+id/btnPrivateMission"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginRight="10dp"
                        android:background="@android:color/transparent"
                        android:onClick="btnPrivateMissionClick"
                        android:scaleType="fitXY"></ImageButton>
                    <!--app:srcCompat="@drawable/private_mission_button"-->

                    <ImageButton
                        android:id="@+id/btnMap"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginLeft="10dp"
                        android:background="@android:color/transparent"
                        android:onClick="btnMapClick"
                        android:scaleType="fitXY" />
                    <!--app:srcCompat="@drawable/map_normal"-->
                </TableRow>

            </TableLayout>

            <!-- 일정표 Layer -->
            <LinearLayout
                android:id="@+id/scheduleLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="35"
                    android:background="@color/colorTitleBack">

                    <TextView
                        android:id="@+id/scheduleMonth"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/colorTitleBack"
                        android:gravity="center"
                        android:text="12월"
                        android:textColor="@color/colorTitleFore"
                        android:textSize="30dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="10">

                    <ListView
                        android:id="@+id/scheduleList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:transcriptMode="alwaysScroll"></ListView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/colorTitleBack">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/btnMainBottom"
                android:text="주요일정"
                android:textColor="@color/colorTitleFore"
                android:background="@color/colorTitleBack"
                android:gravity="center"
                android:onClick="btnMainBottomClick"/>
            <!--ImageButton
                android:id="@+id/btnMainBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/main_bottom"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:onClick="btnMainBottomClick"/-->
        </LinearLayout>

    </LinearLayout>

</android.support.v4.widget.DrawerLayout>
