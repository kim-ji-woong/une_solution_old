{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Site": {
    "DBName": "PubWifi",
    "DBType": 0,
    "WebServerURL": "http://127.0.0.1:809"
  },
  "Data": {
    // 데이터 보존기한(개월)
    "lifeTime": 12,
    // 센서로부터 얼마의 시간 이상 데이터를 못받으면 센서가 꺼진것으로 간주할 것인가?(분)
    "rebootMinutes": 30,
    // 센서가 켜진 이후에 초기 몇 분 동안은 데이터를 무시한다.
    "warmingupMinutes": 10
  },
  "AllowedHosts": "*"
}
