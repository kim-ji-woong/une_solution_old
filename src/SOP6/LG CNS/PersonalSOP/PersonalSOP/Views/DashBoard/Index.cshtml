@{
    Layout = "~/Views/Shared/_DashBoardLayout.cshtml";
    ViewBag.Title = "SOP 진행이력";
}
<h2>대시보드</h2>

<style>
    #ptag1 {
        margin: 0px;
        color: white;
        font-family: "NanumBarunGothic";
    }

    #ptag2 {
        margin: 0px;
        font-family: "NanumBarunGothic";
    }

    #td1 {
        height: 30px;
    }

    td {
        padding: 10px;
    }
</style>

<script type="text/javascript" src="https://code.jquery.com/jquery-1.12.4.min.js"></script>
<script type="text/javascript">
    function loadPartialView() {
        $.ajax({
            url: '@Url.Action("Index2", "DashBoard")',
            type: "POST",
            cache: false,
            async: true,
            success: function (result) {
                if ((typeof (result)).toString() === "string") { 

                    const r = String(result);
                    if (r.includes("[ET]") || r.includes("[CS]"))
                    {                        
                        if (result.startsWith("[ET]"))
                        {
                            if (document.getElementById('elapsedTime') != null) {
                                document.getElementById('elapsedTime').innerHTML = result.substr(4);
                            }
                            /*else
                                console.log("elapsedTime is null");*/
                        }

                        let index = r.indexOf("[CS]");
                        if (index >= 0) {
                            const arr = result.substr(index + 4).split("_");

                            document.getElementById('deadCount').innerHTML = arr[0];
                            document.getElementById('injuryCount').innerHTML = arr[1];
                            document.getElementById('lostCount').innerHTML = arr[2];
                            document.getElementById('tankTemperature').innerHTML = arr[3];
                            //console.log("2");
                        }
                    }
                    else {
                        $('#refreshTable').html(result);
                        console.log("3");
                    }
                }

                //$('#refreshTable').html(result);
            },
            error: function (error) {
                console.log(error);
            }
        });
    }
    
    $(document).ready(function () {
        loadPartialView();
        function RefreshPartial() {
            //this will wait 3 seconds and then fire the load partial function
            setTimeout(function () {
                loadPartialView();
                //recall this function so that it will continue to loop
                RefreshPartial();
            }, 900);
        }
        //initialize the loop
        RefreshPartial();
    });
</script>

<div class="row">
    <div class="col-md-4" id="refreshTable">
        
    </div>
</div>


