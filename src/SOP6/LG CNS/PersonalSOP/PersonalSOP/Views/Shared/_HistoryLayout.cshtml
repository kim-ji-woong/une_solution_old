<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <script defer type="text/javascript" src="~/Scripts/exif.js"></script>
    <link rel="stylesheet" type="text/css" href="~/Content/style.css">
    <link rel="stylesheet" type="text/css" href="~/Content/reset.css">
</head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<body>
    <script>
        function menu() {
            $('.menu-content').toggleClass('active');

        }
        var menuClick = function () {
            var $clicked = $(this);
            if ($clicked.hasClass('active')) {
                $clicked.removeClass('active');
            } else {
                $clicked.addClass('active');
            }
        }

        var $li = $('.nav-m .menu-content li ');
        $li.click(menuClick);

        var $inn = window.$('.nav-m .menu-content li');
        $inn.click(menuClick);

        function toggleimg() {
            var src = ($('.menu').attr('src') === '~/images/menu.png') ? '~/images/close.png' :
                '~/images/menu.png';
            $('.menu').attr('src', src);
        }
    </script>

    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a href="index.html"><img src="~/images/group.png" alt="logo"></a>
                @*@Html.ActionLink("LG화학 재난 시뮬레이션", "DisplayMission", "Mission", new { area = "" }, new { @class = "navbar-brand" })*@
            </div>
            <div class="navbar-collapse collapse">
                <ul>
                    <a href="/Mission/DisplayMission">
                        <li class="sub">개인 임무</li>
                    </a>
                    <a href="/SOPBulletin/DisplayBulletin">
                        <li class="sub">현장 상황</li>
                    </a>
                    <a href="/SOPTalk">
                        <li class="sub">상황 전파</li>
                    </a>
                </ul>
                @*<ul class="nav navbar-nav">
                    <li>@Html.ActionLink("개인별 임무", "DisplayMission", "Mission", new { area = "" }, null)</li>
                    <li>@Html.ActionLink("SOP 전체상황", "DisplayBulletin", "SOPBulletin", new { area = "" }, null)</li>
                    <li>@Html.ActionLink("SOP 메시지", "Index", "SOPTalk", new { area = "" }, null)</li>
                </ul>*@
            </div>
        </div>
    </div>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - 유엔이 스마트 재난관리 시스템</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
