@model PersonalSOP.Models.SOPTalkMessage

@{
    Layout = "~/Views/Shared/_HistoryLayout.cshtml";
}

@using (Html.BeginForm("Index", "SOPTalk", FormMethod.Post, new { @class = "jumbotron", role = "form", enctype = "multipart/form-data" }))
{
    <br />
    <br />
    <br />

    <h2>여기 상황은요...</h2>
    <br />
    <br />
    <div class="form-group">
        <div>
            <label for="file">업로드할 이미지를 선택하세요.</label>
            <input type="file" id="file" name="file" accept=".jpg, .jpeg, .png, .bmp, .gif">

            @if (Model == null)
            {
                <input type="text" class="form-control" name="title" placeholder="제목" autocomplete="on" />
                <textarea type="text" class="form-control" name="message" placeholder="의견을 남겨주세요" style="width: 400px; height: 200px;"></textarea>
            }
            else
            {
                <input type="text" class="form-control" name="title" placeholder="제목" value="@Model.Title" autocomplete="on" />
                <textarea type="text" class="form-control" name="message" placeholder="의견을 남겨주세요" style="width: 400px; height: 200px;">@Model.Message</textarea>
            }
        </div>
        <br />
        <br />
        <div class="preview">
            @if (Model != null && Model.ImageURL.Length > 0)
            {
                <p><img class="img-responsive" src="@Model.ImageURL" /></p>

                if (Model.UploadResult.Length > 0)
                {
                    <p>@Model.UploadResult</p>
                }
            }
        </div>

        @if (Model != null)
        {
            <input type="hidden" id="filename" name="fileName" value="@Model.FileName" />
        }

        <br />
        <input id="submit" type="submit" name="submit" class="btn btn-primary" value="전송" />
    </div>
}

<script type="text/javascript">
    'use strict';
    const input = document.querySelector('input');
    const preview = document.querySelector('.preview');

    input.style.opacity = 0;
    input.addEventListener('change', updateImageDisplay);

    function updateImageDisplay() {
        while (preview.firstChild) {
            preview.removeChild(preview.firstChild);
        }

        const curFiles = input.files;
        if (curFiles.length === 0) {
            const para = document.createElement('p');
            para.textContent = '선택된 이미지가 없습니다.';
            preview.appendChild(para);
        } else {
            for (const file of curFiles) {
                var submit = document.getElementById("submit");
                submit.setAttribute("value", "미리보기");
                submit.click();
                return;
            }
        }
    }
</script>