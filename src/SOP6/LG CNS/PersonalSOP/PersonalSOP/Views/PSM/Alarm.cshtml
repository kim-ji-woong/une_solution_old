@model PersonalSOP.Models.PSMAlarm

@{
    Layout = "~/Views/Shared/_SimulationLayout.cshtml";
}

@using (Html.BeginForm("Alarm", "PSM", FormMethod.Post, new { @class = "jumbotron", role = "form" }))
{
    <h1>SM탱크 알람</h1>
    <div class="form-group">
        <label>탱크이름</label>
        @Html.TextBoxFor(m => m.TankName, new { @class = "form-control", @placeholder = "탱크 이름을 입력하세요." })
    </div>
    <div class="form-group">
        <label>탱크온도(°C)</label>
        @Html.TextBoxFor(m => m.TankAlarmData, new { @class = "form-control", @placeholder = "알람발생시 탱크의 온도를 입력하세요." })


    </div>

    <table frame="void">
        <tr>
            <td>
                <div class="form-group">
                    <input type="submit" name="submit" class="btn btn-primary btn-lg" value="전송" />
                </div>
            </td>
            <td>
                <div>
                    <span>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        @Html.CheckBoxFor(m => m.RealMode)
                        @Html.LabelFor(m => m.RealMode, "실제상황")
                    </span>
                </div>
            </td>
        </tr>
    </table>
}

