@using (Html.BeginForm("LostAricle", "PSM", FormMethod.Post, new { @class = "jumbotron", role = "form" }))
{
    <h1>피해 현황</h1>
    <div class="form-group">
        <label>사망</label>
        @Html.TextBoxFor(m => m.DeadCount, new { @class = "form-control", @placeholder = "사망자 수" })
    </div>
    <div class="form-group">
        <label>부상</label>
        @Html.TextBoxFor(m => m.InjuryCount, new { @class = "form-control", @placeholder = "부상자 수" })
    </div>
    <div class="form-group">
        <label>실종</label>
        @Html.TextBoxFor(m => m.LostCount, new { @class = "form-control", @placeholder = "실종자 수" })
    </div>
    <div class="form-group">
        <label>탱크 온도</label>
        @Html.TextBoxFor(m => m.TankTemp, new { @class = "form-control", @placeholder = "탱크 온도" })
    </div>
    <table frame="void">
        <tr>
            <td>
                <div class="form-group">
                    <input type="submit" name="submit" class="btn btn-primary btn-lg" value="전송" />
                </div>
            </td>
            <td>
                <div>
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    <a class="btn btn-primary btn-lg" href="@Url.Action("InitLostArticle","PSM")">초기화</a>
                </div>
            </td>
        </tr>
    </table>
}
