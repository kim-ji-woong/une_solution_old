<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Log -->
    <add key="logFolder" value="./Log" />
    <!-- 로그 저장기간(일) -->
    <add key="logLifeTime" value="30" />
    <add key="logFileTag" value="PSMExternalServer" />
  </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
</configuration>