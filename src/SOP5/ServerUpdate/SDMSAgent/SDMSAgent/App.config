            </setting>
            <setting name="WebServerUrl" serializeAs="String">
                <value>http://127.0.0.1:8080/SOP</value>
            </setting>
            <setting name="DatabaseHost" serializeAs="String">
                <value>127.0.0.1</value>
            </setting>
            <setting name="DatabasePort" serializeAs="String">
                <value>1433</value>
            </setting>
            <setting name="DataBaseType" serializeAs="String">
                <value>mssql</value>
            </setting>
            <setting name="UpdateTempPath" serializeAs="String">
                <value>C:\Temp\temp</value>
            </setting>
            <setting name="DownloadURL" serializeAs="String">
                <value>C:\Program Files\Apache Software Foundation\Tomcat 7.0\webapps\ROOT\SOP\Download</value>
            </setting>
            <setting name="UpdateSrcPath" serializeAs="String">
                <value>C:\Update_Src</value>
            </setting>
            <setting name="SDMS_update_src" serializeAs="String">
                <value>c:\temp\new</value>
            </setting>
            <setting name="SDMS_update_trg" serializeAs="String">
                <value>C:\Program Files\Apache Software Foundation\Tomcat 7.0\webapps\ROOT\SOP\Update</value>
            </setting>
            <setting name="SDMS_update_temp" serializeAs="String">
                <value>c:\temp\temp</value>
            </setting>
            <setting name="DatabaseName" serializeAs="String">
                <value>SOP_1</value>
            </setting>
            <!--탐색기-->
            <setting name="GetDrivePath" serializeAs="String">
                <value>C:\Program Files\Apache Software Foundation\Tomcat 7.0\webapps\ROOT\SOP\SDMSAgent_Drive.txt</value>
            </setting>
