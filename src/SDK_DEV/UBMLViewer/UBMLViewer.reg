REGEDIT

HKEY_CLASSES_ROOT\.ubml = UBMLViewer.Document
HKEY_CLASSES_ROOT\UBMLViewer.Document\shell\open\command = UBMLViewer.EXE %1
HKEY_CLASSES_ROOT\UBMLViewer.Document\shell\open\ddeexec = [open("%1")]
HKEY_CLASSES_ROOT\UBMLViewer.Document\shell\open\ddeexec\application = UBMLViewer

HKEY_CLASSES_ROOT\UBMLViewer.Document = UBMLViewer.Document

