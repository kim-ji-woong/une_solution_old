        MENUITEM "1 Minute",                    ID_SEARCH_G2_MOVE_1MINUTE
        MENUITEM "5 Minute",                    ID_SEARCH_G2_MOVE_5MINUTE
        MENUITEM "10 Minute",                   ID_SEARCH_G2_MOVE_10MINUTE
        MENUITEM "15 Minute",                   ID_SEARCH_G2_MOVE_15MINUTE
        MENUITEM "30 Minute",                   ID_SEARCH_G2_MOVE_30MINUTE
        MENUITEM "60 Minute",                   ID_SEARCH_G2_MOVE_60MINUTE
    END
    POPUP "Additional"
    BEGIN
        POPUP "Data Source"
