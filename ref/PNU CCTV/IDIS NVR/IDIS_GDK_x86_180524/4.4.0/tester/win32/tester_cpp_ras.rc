// Toolbar
//

IDR_MAINFRAME TOOLBAR  16, 15
BEGIN
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
    SEPARATOR
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
    SEPARATOR
    BUTTON      ID_FILE_PRINT
    BUTTON      ID_APP_ABOUT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&System"
    BEGIN
        MENUITEM "&Add",                        ID_MAIN_SYSTEM_ADD
        MENUITEM "&Modify",                     ID_MAIN_SYSTEM_MODIFY
        MENUITEM "&Remove",                     ID_MAIN_SYSTEM_REMOVE
        MENUITEM "&Status",                     ID_MAIN_SYSTEM_STATUS
        MENUITEM SEPARATOR
        MENUITEM "E&xit...",                    ID_APP_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About G2Client...",          ID_APP_ABOUT
    END
END

IDR_MENU_CAMERA_CONTEXT MENU 
BEGIN
    POPUP "Screen"
    BEGIN
        MENUITEM "Watch",                       ID_SCREEN_CONNECT_WATCH
        MENUITEM "Search",                      ID_SCREEN_CONNECT_SEARCH
    END
    POPUP "Camera"
    BEGIN
        MENUITEM "Listen",                      ID_CAMERA_LISTEN
        MENUITEM "Talk",                        ID_CAMERA_TALK
        MENUITEM SEPARATOR
        MENUITEM "Instant record",              ID_CAMERA_INSTANT_RECORD
        MENUITEM SEPARATOR
        POPUP "Aspect ratio"
        BEGIN
            MENUITEM "Fit to screen",               ID_CAMERA_RATIO_FIT_TO_SCREEN
            MENUITEM "Original ratio",              ID_CAMERA_RATIO_ORIGINAL
        END
        MENUITEM SEPARATOR
        POPUP "Remove"
        BEGIN
            MENUITEM "Camera",                      ID_CAMERA_REMOVE_CAMERA
            MENUITEM "Device",                      ID_CAMERA_REMOVE_DEVICE
            MENUITEM SEPARATOR
            MENUITEM "All cameras",                 ID_CAMERA_REMOVE_ALL
        END
    END
END


