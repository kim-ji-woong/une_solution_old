IDR_MENU_SEARCH MENU 
BEGIN
    POPUP "Goto"
    BEGIN
        MENUITEM "Go to...",                    ID_PLAY_GOTO_TIME
        MENUITEM SEPARATOR
        MENUITEM "Move first",                  ID_PLAY_GOTO_FIRST
        MENUITEM "Move last",                   ID_PLAY_GOTO_LAST
    END
    POPUP "Move"
    BEGIN
        MENUITEM "1 Frame",                     ID_PLAY_MOVE_1FRAME
        MENUITEM "1 Minute",                    ID_PLAY_MOVE_1MINUTE
        MENUITEM "5 Minute",                    ID_PLAY_MOVE_5MINUTE
        MENUITEM "10 Minute",                   ID_PLAY_MOVE_10MINUTE
        MENUITEM "15 Minute",                   ID_PLAY_MOVE_15MINUTE
        MENUITEM "30 Minute",                   ID_PLAY_MOVE_30MINUTE
        MENUITEM "60 Minute",                   ID_PLAY_MOVE_60MINUTE
    END
    POPUP "Additional"
    BEGIN
        POPUP "Data Source"
        BEGIN
            MENUITEM "Search on Local",             ID_DATASOURCE_SEARCHONLOCAL
            MENUITEM "Search on Archive",           ID_DATASOURCE_SEARCHONARCHIVE
            MENUITEM "Search on Other",             ID_DATASOURCE_SEARCHONOTHER
        END
        MENUITEM "Select Segment...",           ID_ADDITIONAL_SELECTSEGMENT
    END
END

